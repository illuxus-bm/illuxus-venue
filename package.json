{
  "name": "illuxus-vendor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Illuxus Venues: venue-partner portal (web, Android, iOS) sharing the Illuxus Supabase backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:native": "vite build --mode native",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p server/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/tests/run.sh",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:assets": "npx --yes @capacitor/assets generate --iconBackgroundColor '#7E22CE' --iconBackgroundColorDark '#7E22CE' --splashBackgroundColor '#fafafa' --splashBackgroundColorDark '#121212'",
    "android:release": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "postinstall": "prisma generate",
    "api:dev": "tsx watch --env-file-if-exists=.env server/src/server.ts",
    "api:build": "prisma generate && tsc -p server/tsconfig.json",
    "api:start": "node server/dist/src/server.js",
    "api:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test:api": "vitest run --config server/vitest.config.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:pull": "prisma db pull --print",
    "db:baseline": "prisma migrate resolve --applied 0_init && prisma migrate deploy",
    "user:create": "tsx server/scripts/create-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.8",
    "@hookform/resolvers": "^7.0.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^31.0.1",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
