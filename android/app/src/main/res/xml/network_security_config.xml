<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app's own content is served from https://localhost by
     Capacitor; Supabase and every other host must be TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
