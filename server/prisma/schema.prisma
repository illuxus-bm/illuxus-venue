/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model venue_media {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id   String   @db.Uuid
  url        String
  caption    String?
  media_kind String   @default("empty_hall")
  is_cover   Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  venues     venues   @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([venue_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model venues {
  id                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id                    String                @db.Uuid
  name                         String
  space_type                   String?
  description                  String?
  is_active                    Boolean               @default(true)
  area_sqft                    Int?
  length_ft                    Decimal?              @db.Decimal(6, 1)
  width_ft                     Decimal?              @db.Decimal(6, 1)
  ceiling_height_ft            Decimal?              @db.Decimal(4, 1)
  capacity_floating            Int?
  capacity_theater             Int?
  capacity_banquet             Int?
  capacity_ushape              Int?
  capacity_classroom           Int?
  climate_control              String?
  has_stage                    Boolean               @default(false)
  stage_dimensions             String?
  green_rooms_count            Int?
  has_projector                Boolean               @default(false)
  has_screen                   Boolean               @default(false)
  has_sound_system             Boolean               @default(false)
  has_microphones              Boolean               @default(false)
  has_power_backup             Boolean               @default(false)
  has_wifi                     Boolean               @default(false)
  catering_policy              String?
  decor_policy                 String?
  alcohol_policy               String?
  music_curfew_time            DateTime?             @db.Time(6)
  noise_restrictions           String?
  parking_car_capacity         Int?
  parking_two_wheeler_capacity Int?
  has_valet                    Boolean               @default(false)
  wheelchair_accessible        Boolean               @default(false)
  has_elevator                 Boolean               @default(false)
  created_at                   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  address_line                 String?
  city                         String?
  state                        String?
  pincode                      String?
  map_url                      String?
  vendor_availability          vendor_availability[]
  vendor_services              vendor_services[]
  venue_media                  venue_media[]
  vendors                      vendors               @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_active])
  @@index([vendor_id])
}

// -----------------------------------------------------------------------------
// Self-hosted auth (AUTH_PROVIDER=local, e.g. on AWS). Unused with Supabase
// Auth, whose users live in auth.users.
// -----------------------------------------------------------------------------

/// Portal users when the API owns authentication. Invite-only: created with
/// `npm run user:create`, never by public sign-up.
model app_users {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String          @unique
  password_hash     String
  display_name      String?
  email_verified_at DateTime?       @db.Timestamptz(6)
  disabled_at       DateTime?       @db.Timestamptz(6)
  failed_logins     Int             @default(0)
  locked_until      DateTime?       @db.Timestamptz(6)
  last_login_at     DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  auth_sessions     auth_sessions[]
}

/// Refresh-token sessions. Only a SHA-256 of the token is stored; tokens
/// rotate on every refresh and reuse of a rotated token revokes the family.
model auth_sessions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  family_id   String    @db.Uuid
  token_hash  String    @unique
  user_agent  String?
  ip          String?
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  replaced_by String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  app_users   app_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
}
