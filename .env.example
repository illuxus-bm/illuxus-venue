# Copy to .env and fill in. Every VITE_* value is compiled into the public
# bundle, so never put secrets (service-role keys, SMTP passwords) here.

# Supabase project shared with the main illuxus app (Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Main illuxus app (organizer side). Used for "Plan an event" links.
VITE_ILLUXUS_ORIGIN=https://illuxus.com

# Comma-separated invite list for the vendor portal sign-in screen.
# UX gate only: the database allowlist (migration 105) is the real control.
# Leave empty to rely on the database check alone.
VITE_VENDOR_ALLOWED_EMAILS=

# Optional: endpoint that receives client error reports as JSON POSTs
# (Sentry tunnel, Supabase Edge Function, log collector...). If it's not on
# *.supabase.co, add its origin to connect-src in vercel.json's CSP.
VITE_ERROR_REPORT_URL=

# Optional: release identifier attached to error reports (CI sets it).
VITE_APP_VERSION=
