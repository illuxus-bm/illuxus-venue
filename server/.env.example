# ============================================================================
# Illuxus Venues API: copy to the repo-root .env (or set in your host).
# Validated at boot: a missing/invalid value stops the server with a clear
# message instead of failing later. Never commit real values.
# ============================================================================

NODE_ENV=production
PORT=8787
LOG_LEVEL=info

# ── Database (Prisma) ───────────────────────────────────────────────────────
# Runtime connection (pooled is fine).
#   Supabase: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   AWS RDS : postgresql://<user>:<pw>@<instance>.<region>.rds.amazonaws.com:5432/<db>
DATABASE_URL=
# Migrations / introspection need a DIRECT (session) connection.
#   Supabase: ...pooler.supabase.com:5432/postgres   AWS: same host as above (not RDS Proxy)
DIRECT_URL=
# TLS: keep sslmode OUT of the URLs and set it here. Supabase: require. RDS: verify-full (+ CA).
DATABASE_SSL=require
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."   # RDS global bundle for verify-full
DB_POOL_MAX=10

# ── Auth ────────────────────────────────────────────────────────────────────
# supabase: keep Supabase Auth; the API verifies its JWTs.
# local:    the API owns sign-in (argon2 passwords, rotating refresh tokens).
AUTH_PROVIDER=supabase
SUPABASE_URL=https://<ref>.supabase.co          # JWKS for asymmetric signing keys
# SUPABASE_JWT_SECRET=                          # only for legacy HS256 projects
# JWT_SECRET=                                   # AUTH_PROVIDER=local: `openssl rand -hex 32`
# VENDOR_ALLOWED_EMAILS=a@x.com,b@y.com         # optional extra gate

# ── HTTP ────────────────────────────────────────────────────────────────────
# Extra browser origins (localhost:8081 and the Capacitor origins are built in).
CORS_ORIGINS=https://venues.illuxus.com
RATE_LIMIT_PER_MINUTE=300

# ── Storage (S3 API) ────────────────────────────────────────────────────────
# Supabase Storage: Settings → Storage → S3 connection
#   STORAGE_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
#   STORAGE_FORCE_PATH_STYLE=true
#   STORAGE_PUBLIC_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public
# AWS S3 (+ CloudFront):
#   STORAGE_ENDPOINT=                    (empty = AWS)
#   STORAGE_PUBLIC_BASE_URL=https://<distribution>.cloudfront.net  (origin path = bucket names)
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=
BUCKET_VENUE_MEDIA=venue-media
BUCKET_VENDOR_MEDIA=vendor-media

# ── Email (organizer notifications) ─────────────────────────────────────────
# Any SMTP. AWS SES: smtps://<smtp-user>:<smtp-pass>@email-smtp.<region>.amazonaws.com:465
SMTP_URL=
EMAIL_FROM="Illuxus Venues <no-reply@illuxus.com>"
ILLUXUS_ORIGIN=https://illuxus.com
