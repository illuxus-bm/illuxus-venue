# Copy to .env and fill in. Every VITE_* value is compiled into the public
# bundle, so never put secrets (service-role keys, SMTP passwords) here.

# REST API base URL (server/, docs/API.md). Leave empty on the web to call
# the same origin at /api. Native (Capacitor) builds MUST set an absolute
# URL, e.g. https://api.example.com/api, and the API's CORS_ORIGINS / CSP
# must allow it. For local dev without a /api proxy, point it at the API
# directly, e.g. http://localhost:8787/api.
VITE_API_URL=

# Which auth backend signs vendors in: "supabase" (default) or "local".
# Must match the API's AUTH_PROVIDER.
#   supabase: supabase-js is used ONLY for sign-in/session; set the
#             VITE_SUPABASE_* values below.
#   local:    POST /api/auth/login|refresh|logout; VITE_SUPABASE_* unused.
VITE_AUTH_PROVIDER=supabase

# Supabase project shared with the main illuxus app (Settings → API).
# Only needed when VITE_AUTH_PROVIDER=supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Main illuxus app (organizer side). Used for "Plan an event" links.
VITE_ILLUXUS_ORIGIN=https://illuxus.com

# Comma-separated invite list for the vendor portal sign-in screen.
# UX gate only: the API's vendor-membership check is the real control.
# Leave empty to rely on the server check alone.
VITE_VENDOR_ALLOWED_EMAILS=

# Optional: endpoint that receives client error reports as JSON POSTs
# (Sentry tunnel, log collector...). If it's not same-origin, add its origin
# to connect-src in vercel.json's CSP.
VITE_ERROR_REPORT_URL=

# Optional: release identifier attached to error reports (CI sets it).
VITE_APP_VERSION=
