// =============================================================================
// Illuxus Venues: Prisma schema
// =============================================================================
// Introspected (`prisma db pull`) from a database built by applying
// supabase/migrations/100-111 on top of the shared Illuxus base schema, so
// table and column names map 1:1 onto the live Supabase tables.
//
// Portable between Supabase Postgres and AWS RDS / Aurora Postgres:
//  * No cross-schema relations. Columns that point at users (user_id,
//    reviewer_id, owner_id, created_by, sender_id) are plain UUIDs. On
//    Supabase they hold auth.users ids; on AWS they hold app_users ids.
//  * `updated_at` is maintained by Prisma (@updatedAt), not triggers.
//  * Constraints Prisma can't express (expression indexes, CHECKs) live in
//    raw SQL in migrations/1_portable_constraints.
//
// The main illuxus app owns some of these tables (events, organizations,
// profiles, ...). When it changes them, re-run `npm run db:pull` and diff.
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_milestones {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String          @db.Uuid
  label           String
  amount          BigInt
  due_date        DateTime?       @db.Date
  status          String          @default("pending")
  paid_at         DateTime?       @db.Timestamptz(6)
  sort_order      Int             @default(0)
  vendor_bookings vendor_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id], map: "booking_milestones_booking_id_fkey_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model event_venue_selections {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id                 String    @db.Uuid
  vendor_id                String    @db.Uuid
  org_id                   String    @db.Uuid
  selected_by              String?   @db.Uuid
  status                   String    @default("contacted")
  notes                    String?
  notified_at              DateTime? @db.Timestamptz(6)
  responded_at             DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  selected_service_ids     String[]  @default([]) @db.Uuid
  event_type               String?
  event_duration_hours     Decimal?  @db.Decimal(6, 2)
  expected_attendees       Int?
  seating_capacity         Int?
  seating_arrangement      String?
  needs_pre_function_area  Boolean   @default(false)
  needs_vip_area           Boolean   @default(false)
  needs_additional_rooms   Boolean   @default(false)
  venue_link               String?
  venue_id                 String?   @db.Uuid
  response_notified_status String?
  events                   events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendors                  vendors   @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  venues                   venues?   @relation(fields: [venue_id], references: [id], onUpdate: NoAction)

  @@unique([event_id, vendor_id])
  @@index([selected_by], map: "event_venue_selections_selected_by_fkey_idx")
  @@index([venue_id])
  @@index([event_id], map: "idx_event_venue_selections_event")
  @@index([org_id], map: "idx_event_venue_selections_org")
  @@index([vendor_id], map: "idx_event_venue_selections_vendor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  id                           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                      String                   @db.Uuid
  org_id                       String?                  @db.Uuid
  title                        String
  description                  String?
  slug                         String
  date                         DateTime                 @db.Timestamptz(6)
  end_date                     DateTime?                @db.Timestamptz(6)
  venue                        String?
  location                     String?
  capacity                     Int?                     @default(0)
  tickets_sold                 Int?                     @default(0)
  price                        Decimal?                 @default(0) @db.Decimal(10, 2)
  currency                     String                   @default("INR")
  timezone                     String?
  status                       String                   @default("draft")
  event_format                 String                   @default("physical")
  virtual_provider             String?
  virtual_url                  String?
  requires_approval            Boolean                  @default(false)
  cover_video_url              String?
  image_url                    String?
  banner_landscape_url         String?
  banner_portrait_url          String?
  page_config                  Json?
  attendance_target_pct        Int?
  webinar_branding_enabled     Boolean?
  created_at                   DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  speaker_applications_enabled Boolean                  @default(true)
  sponsor_applications_enabled Boolean                  @default(true)
  create_community             Boolean                  @default(true)
  community_category           String?                  @default("other")
  previous_event_id            String?                  @db.Uuid
  video_provider               String?
  published                    Boolean?                 @default(false)
  deleted_at                   DateTime?                @db.Timestamptz(6)
  ask_sponsor_consent          Boolean                  @default(false)
  event_venue_selections       event_venue_selections[]
  organizations                organizations?           @relation(fields: [org_id], references: [id], onUpdate: NoAction)
  events                       events?                  @relation("eventsToevents", fields: [previous_event_id], references: [id], onUpdate: NoAction)
  other_events                 events[]                 @relation("eventsToevents")

  @@unique([org_id, slug], map: "events_slug_org_unique")
  @@index([previous_event_id], map: "events_previous_event_idx", where: raw("(previous_event_id IS NOT NULL)"))
  @@index([slug])
  @@index([org_id, date(sort: Desc)], map: "idx_events_org_date")
  @@index([org_id], map: "idx_events_org_id")
  @@index([status, date(sort: Desc)], map: "idx_events_status_date")
  @@index([user_id], map: "idx_events_user_id")
}

