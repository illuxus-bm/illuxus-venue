// =============================================================================
// Illuxus Venues: Prisma schema
// =============================================================================
// Introspected (`prisma db pull`) from a database built by applying
// supabase/migrations/100-111 on top of the shared Illuxus base schema, so
// table and column names map 1:1 onto the live Supabase tables.
//
// Portable between Supabase Postgres and AWS RDS / Aurora Postgres:
//  * No cross-schema relations. Columns that point at users (user_id,
//    reviewer_id, owner_id, created_by, sender_id) are plain UUIDs. On
//    Supabase they hold auth.users ids; on AWS they hold app_users ids.
//  * `updated_at` is maintained by Prisma (@updatedAt), not triggers.
//  * Constraints Prisma can't express (expression indexes, CHECKs) live in
//    raw SQL in migrations/1_portable_constraints.
//
// Before baselining against the real Supabase project, re-run
// `npm run db:pull` there and diff: the base tables owned by the main app
// were reconstructed from usage, not read from its migrations.
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model booking_milestones {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String          @db.Uuid
  label           String
  amount          BigInt          @default(0)
  due_date        DateTime?       @db.Date
  status          String          @default("pending")
  sort_order      Int             @default(0)
  completed_at    DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  vendor_bookings vendor_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model event_venue_selections {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id                 String    @db.Uuid
  vendor_id                String    @db.Uuid
  venue_id                 String?   @db.Uuid
  status                   String    @default("contacted")
  notes                    String?
  selected_service_ids     String[]  @default([]) @db.Uuid
  event_type               String?
  event_duration_hours     Decimal?  @db.Decimal(5, 1)
  expected_attendees       Int?
  seating_capacity         Int?
  seating_arrangement      String?
  needs_pre_function_area  Boolean   @default(false)
  needs_vip_area           Boolean   @default(false)
  needs_additional_rooms   Boolean   @default(false)
  venue_link               String?
  responded_at             DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  response_notified_status String?
  events                   events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendors                  vendors   @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id])
  @@index([vendor_id])
  @@index([vendor_id], map: "event_venue_selections_vendor_idx")
  @@index([venue_id, status], map: "event_venue_selections_venue_status_idx")
}

